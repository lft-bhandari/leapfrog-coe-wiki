# Synthesis backend: "ollama" (default) or "bedrock"
SYNTHESIS_BACKEND=ollama

# --- Ollama settings (used when SYNTHESIS_BACKEND=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- AWS Bedrock settings (used when SYNTHESIS_BACKEND=bedrock) ---
# Temporary session credentials (from `aws sts assume-role` or SSO login)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

AWS_REGION=us-east-1
# Newer models (Haiku 4.5+) require the us. cross-region inference profile prefix.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Required on networks with SSL inspection (corporate proxy with self-signed cert).
# Set to the system CA bundle so boto3 can verify the Bedrock TLS certificate.
AWS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
